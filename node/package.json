      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE"],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test tests/*.test.mjs"
