{
  "name": "blindrelay",
  "version": "0.1.0",
  "description": "Official Node.js and TypeScript SDK for the Blindrelay transactional email API.",
  "license": "MIT",
  "homepage": "https://blindrelay.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blindrelay-app/sdks.git",
    "directory": "node"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
