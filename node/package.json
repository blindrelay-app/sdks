  "peerDependencies": {
    "@react-email/render": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-email/render": "2.2.0",
    "@types/node": "22.20.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
